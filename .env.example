# PLAIN ENGLISH: This is a TEMPLATE for the app's private settings.
# Copy it to a file named ".env" (cp .env.example .env) and edit the copy.
# The real ".env" is never committed to git (see .gitignore) because it holds secrets.

APP_NAME=Org Automation Scaffold
ENVIRONMENT=development
DATABASE_PATH=./org_dev.sqlite3
LOG_LEVEL=INFO

# "demo"   = simple rule-based reader, no internet, no AI. Safe default.
# "claude" = uses Claude to read documents (needs ANTHROPIC_API_KEY and `pip install -e ".[claude]"`).
EXTRACTION_MODE=demo
# ANTHROPIC_API_KEY=sk-ant-...   <- put your real key in .env only, never in this file
CLAUDE_MODEL=claude-sonnet-5-5

# Optional runtime-selected OpenAI-compatible generation provider (Ollama works at http://localhost:11434/v1).
# The settings screen can switch providers in-memory during development. These are startup defaults.
LLM_PROVIDER=claude
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
# LLM_API_KEY=                 # optional for local Ollama; use a secret for remote compatible endpoints

# Optional local semantic retrieval. Requires Ollama and `ollama pull nomic-embed-text`.
# Set EMBEDDING_MODE=ollama, then run `python scripts/index_policies.py` again to embed indexed chunks.
EMBEDDING_MODE=none
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# Which CRM to use: "mock" (pretend, default) or "salesforce" (fill in the SALESFORCE_* lines; see docs/SALESFORCE_SETUP.md).
CRM_PROVIDER=mock
# SALESFORCE_DOMAIN=https://yourfirm--sandbox.sandbox.my.salesforce.com   <- use a SANDBOX first
# SALESFORCE_CLIENT_ID=<consumer key>
# SALESFORCE_CLIENT_SECRET=<consumer secret>     <- real secrets go in .env only, never in this file
# SALESFORCE_API_VERSION=v62.0
# SALESFORCE_OBJECT=Contact                      <- or Account for Person Accounts
# SALESFORCE_CLIENT_ID_FIELD=Client_ID__c
# SALESFORCE_EMAIL_FIELD=Email
# SALESFORCE_EFFECTIVE_DATE_FIELD=Email_Effective_Date__c

# Who drives the tools: "scripted" (fixed order, no AI) or "llm" (configured Claude/OpenAI-compatible/local model chooses).
# AGENT_MODE is separate from LLM_PROVIDER: choose llm to let the model select tool calls.
AGENT_MODE=scripted
AGENT_MAX_TOOL_CALLS=20

# If the AI is less sure than this (0 to 1), a person must look at the document.
MIN_CONFIDENCE=0.85

# Who may call the API. Format: name:secret:role,name:secret:role
#   role "service"  = automation (e.g. Power Automate) that submits documents
#   role "reviewer" = a human who approves/rejects and can verify the audit log
# These are DEMO values. Real deployments use a secrets manager and SSO instead.
API_KEYS=flow:demo-service-key:service,alice:demo-alice-key:reviewer,bob:demo-bob-key:reviewer

# Shared secret used to prove a DocuSign webhook really came from DocuSign.
# Leave blank and the webhook endpoint refuses all traffic (safe default).
DOCUSIGN_HMAC_SECRET=demo-docusign-secret

# Microsoft 365 / Graph: file an approval record in ONE SharePoint site after a human approves a change.
# ARCHIVE_PROVIDER=none          <- none (default) | mock (local demo table) | sharepoint
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=           <- real secret in .env only; prefer a certificate or managed identity in production
# GRAPH_SITE_ID=                 <- one site, granted via Sites.Selected (not tenant-wide)
# GRAPH_FOLDER=Client Updates
# WRITE_MODE=enabled             <- required before a real SharePoint archive writes anything

# Sign-in. api_key (default, demo-grade shared keys) | entra (Microsoft Entra ID only) | hybrid (both, for migration).
# AUTH_MODE=entra
# ENTRA_TENANT_ID=               <- your directory (tenant) id
# ENTRA_API_CLIENT_ID=           <- app registration for THIS API (has scope access_as_user and app roles Reviewer / Service)
# ENTRA_SPA_CLIENT_ID=           <- app registration for the browser page (Single-page application, redirect https://host/ui/)
# ENTRA_GROUP_ROLES=             <- optional "<group-object-id>:reviewer"; prefer app roles
